# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Password for the /admin page (choose your own)
ADMIN_PASSWORD=choose-a-long-password

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Optional. Leave empty to use your main calendar.
GOOGLE_CALENDAR_ID=
